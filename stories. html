/* =========================
   VARIABLES
========================= */

let currentStory=null;

let storyTimer=0;

let timerInterval=null;

let storyScore=0;

let answeredQuestions=0;


/* =========================
   FILTER STORIES
========================= */

function filterStories(){

const language=
document.getElementById("language").value;

const level=
document.getElementById("level").value;

const type=
document.getElementById("type").value;

const cards=
document.querySelectorAll(".story-card");

let found=0;

cards.forEach(card=>{

const matchLanguage=
card.dataset.language===language;

const matchLevel=
card.dataset.level===level;

const matchType=
type==="all" ||
card.dataset.type===type;

if(matchLanguage && matchLevel && matchType){

card.style.display="block";

found++;

}else{

card.style.display="none";

}

});


document.getElementById("empty").style.display=
found===0 ? "block":"none";

}


/* =========================
   OPEN STORY
========================= */

function openStory(id){

currentStory=stories[id];

storyScore=0;

answeredQuestions=0;


/* Title */

document.getElementById("storyTitle").textContent=
currentStory.title;


/* Story */

document.getElementById("storyText").innerHTML=
currentStory.text;


/* Vocabulary */

const vocab=
document.getElementById("storyVocabulary");

vocab.innerHTML="";

currentStory.vocabulary.forEach(item=>{

const div=
document.createElement("div");

div.className="vocab-item";

div.innerHTML=
"<strong>"+item[0]+"</strong><br>"+item[1];

vocab.appendChild(div);

});


/* Questions */

const questions=
document.getElementById("questionsContainer");

questions.innerHTML="";


currentStory.questions.forEach((question,index)=>{

const box=
document.createElement("div");

box.className="question-box";

box.innerHTML=
"<p>"+(index+1)+". "+question.q+"</p>";

question.options.forEach((option,i)=>{

const button=
document.createElement("button");

button.className="question-option";

button.textContent=option;

button.onclick=function(){

answerQuestion(
button,
i,
question.answer,
box
);

};

box.appendChild(button);

});

questions.appendChild(box);

});


document.getElementById("storyResult").style.display="none";

document.getElementById("reader").style.display="block";


/* Timer */

startTimer();


/* Scroll */

document.getElementById("reader")
.scrollIntoView({
behavior:"smooth"
});

}


/* =========================
   ANSWER QUESTION
========================= */

function answerQuestion(
button,
selected,
correct,
box
){

const buttons=
box.querySelectorAll(".question-option");

buttons.forEach(btn=>{
btn.disabled=true;
});


if(selected===correct){

button.classList.add("correct");

storyScore++;

}else{

button.classList.add("wrong");

buttons[correct].classList.add("correct");

}

answeredQuestions++;


if(answeredQuestions===
currentStory.questions.length){

showStoryResult();

}

}


/* =========================
   RESULT
========================= */

function showStoryResult(){

const result=
document.getElementById("storyResult");

const percentage=
Math.round(
(storyScore/currentStory.questions.length)*100
);


document.getElementById("storyResultTitle")
.textContent=
percentage>=80
?"🏆 Excellent!"
:"📚 Keep Practicing!";


document.getElementById("storyResultText")
.textContent=
"You scored "+storyScore+
" out of "+
currentStory.questions.length+
" ("+percentage+"%).";


result.style.display="block";

}


/* =========================
   TEXT TO SPEECH
========================= */

function speakStory(){

if(!currentStory)return;

if("speechSynthesis" in window){

const temp=
document.createElement("div");

temp.innerHTML=
currentStory.text;

const text=
temp.innerText;

const speech=
new SpeechSynthesisUtterance(text);

speech.lang=
currentStory.language;

speech.rate=.75;

window.speechSynthesis.cancel();

window.speechSynthesis.speak(speech);

}

}


/* =========================
   STOP SPEECH
========================= */

function stopSpeaking(){

if("speechSynthesis" in window){

window.speechSynthesis.cancel();

}

}


/* =========================
   BOOKMARK
========================= */

function bookmarkStory(){

if(!currentStory)return;

localStorage.setItem(
"linguapathBookmark",
currentStory.title
);

alert("🔖 Story bookmarked!");

}


/* =========================
   CLOSE
========================= */

function closeStory(){

stopSpeaking();

clearInterval(timerInterval);

document.getElementById("reader").style.display="none";

window.scrollTo({
top:0,
behavior:"smooth"
});

}


/* =========================
   TIMER
========================= */

function startTimer(){

clearInterval(timerInterval);

storyTimer=0;

document.getElementById("timer").textContent=
"00:00";


timerInterval=
setInterval(()=>{

storyTimer++;

const minutes=
Math.floor(storyTimer/60);

const seconds=
storyTimer%60;

document.getElementById("timer").textContent=
String(minutes).padStart(2,"0")+
":"+
String(seconds).padStart(2,"0");

},1000);

}

</script>


